<Window x:Class="RPLauncher.App.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RP Launcher — Configuration initiale"
        Width="640" Height="600"
        MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="{StaticResource BgDarkest}">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Bienvenue sur RP Launcher" Style="{StaticResource TitleText}"/>
        <TextBlock Grid.Row="1" Margin="0,6,0,20" Style="{StaticResource SubtleText}"
                   Text="Avant de commencer, on vérifie où est installé Farming Simulator 25 et où créer le profil dédié au serveur RP."/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,12,0">
            <TextBlock Text="1. Installation de Farming Simulator 25" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock x:Name="DetectionResultText" Text="Détection en cours..." Style="{StaticResource SubtleText}"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="GamePathTextBox" Grid.Column="0" IsReadOnly="True" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="Parcourir..." Style="{StaticResource SecondaryButton}" Click="BrowseGamePath_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Text="2. Dossier du profil RP (séparé de vos mods personnels)" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Un profil et un dossier de mods dédiés seront créés ici, à côté de votre profil FS25 habituel. Vos mods personnels ne seront jamais touchés." Style="{StaticResource SubtleText}" TextWrapping="Wrap"/>
                    <TextBox x:Name="RpProfileBasePathTextBox" Margin="0,10,0,0" IsReadOnly="True"/>
                </StackPanel>
            </Border>

            <TextBlock Text="3. Adresse du manifeste du modpack (GitHub)" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <Border Background="{StaticResource BgCard}" CornerRadius="8" Padding="14">
                <StackPanel>
                    <TextBlock Text="URL brute (raw) du fichier modpack.json publié par l'administrateur du serveur." Style="{StaticResource SubtleText}" TextWrapping="Wrap"/>
                    <TextBox x:Name="ManifestUrlTextBox" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <TextBlock x:Name="ErrorText" Foreground="{StaticResource AccentRed}" VerticalAlignment="Center" Margin="0,0,16,0" TextWrapping="Wrap" MaxWidth="300"/>
            <Button Content="Terminer" Style="{StaticResource PrimaryButton}" Click="Finish_Click"/>
        </StackPanel>
    </Grid>
</Window>
