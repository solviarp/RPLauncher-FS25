<UserControl x:Class="RPLauncher.App.Views.ModpackView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="Modpack" Style="{StaticResource TitleText}" Margin="0,0,0,20"/>

        <Border DockPanel.Dock="Top" Background="{StaticResource BgCard}" CornerRadius="12" Padding="20" Margin="0,0,0,16">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock x:Name="VersionText" Text="Version : —" FontWeight="SemiBold" FontSize="15"/>
                        <TextBlock x:Name="ModsCountText" Text="" Style="{StaticResource SubtleText}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Réparer l'installation" Style="{StaticResource SecondaryButton}" Click="Repair_Click"/>
                </Grid>
                <ProgressBar x:Name="RepairProgressBar" Margin="0,14,0,0" Visibility="Collapsed"/>
                <TextBlock x:Name="RepairStatusText" Style="{StaticResource SubtleText}" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <TextBlock DockPanel.Dock="Top" Text="Changements récents" FontWeight="SemiBold" Margin="0,0,0,10"/>
        <ScrollViewer>
            <StackPanel x:Name="ChangelogPanel"/>
        </ScrollViewer>
    </DockPanel>
</UserControl>
