<UserControl x:Class="RPLauncher.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="SOLVIA RP" Style="{StaticResource TitleText}"/>

        <Border Background="{StaticResource BgCard}" CornerRadius="14" Padding="28" Margin="0,20,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="StatusDot" Width="12" Height="12" Fill="{StaticResource AccentAmber}" Margin="0,0,10,0"/>
                    <TextBlock x:Name="StatusText" Text="Vérification en cours..." FontSize="16" FontWeight="SemiBold"/>
                </StackPanel>

                <TextBlock x:Name="PlayersText" Text="" Style="{StaticResource SubtleText}" Margin="22,8,0,0"/>
                <TextBlock x:Name="ModpackVersionText" Text="" Style="{StaticResource SubtleText}" Margin="22,4,0,0"/>
                <TextBlock x:Name="ModpackStatusText" Text="" Margin="22,4,0,0"/>

                <ProgressBar x:Name="SyncProgressBar" Margin="0,20,0,0" Visibility="Collapsed"/>
                <TextBlock x:Name="SyncProgressText" Style="{StaticResource SubtleText}" Margin="0,6,0,0" Visibility="Collapsed"/>

                <Button x:Name="ActionButton" Content="JOUER" Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Left" Margin="0,24,0,0" Click="ActionButton_Click" IsEnabled="False"/>

                <TextBlock x:Name="ErrorText" Foreground="{StaticResource AccentRed}" Margin="0,14,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
