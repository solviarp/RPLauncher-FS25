<Window x:Class="RPLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Solvia Launcher" Height="720" Width="1180"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkest}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource BgPanel}">
            <StackPanel Margin="0,24,0,0">
                <StackPanel Orientation="Horizontal" Margin="20,0,0,28">
                    <Ellipse Width="10" Height="10" Fill="{StaticResource AccentGreen}" Margin="0,0,8,0"/>
                    <TextBlock Text="RP LAUNCHER" FontWeight="Bold" FontSize="14"/>
                </StackPanel>

                <RadioButton x:Name="NavHome" Style="{StaticResource NavButton}" GroupName="Nav" IsChecked="True" Checked="Nav_Checked">
                    <TextBlock Text="Accueil"/>
                </RadioButton>
                <RadioButton x:Name="NavModpack" Style="{StaticResource NavButton}" GroupName="Nav" Checked="Nav_Checked">
                    <TextBlock Text="Modpack"/>
                </RadioButton>
                <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" GroupName="Nav" Checked="Nav_Checked">
                    <TextBlock Text="Paramètres"/>
                </RadioButton>
                <RadioButton x:Name="NavLogs" Style="{StaticResource NavButton}" GroupName="Nav" Checked="Nav_Checked">
                    <TextBlock Text="Logs"/>
                </RadioButton>
            </StackPanel>
        </Border>

        <ContentControl x:Name="MainContent" Grid.Column="1" Margin="36"/>
    </Grid>
</Window>
